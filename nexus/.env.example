# NEXUS Environment Configuration Example
# Copy this file to .env and fill in your actual values

# ============================================
# DATABASE - Neon (Postgres with pgvector)
# ============================================
NEON_DATABASE_URL=postgresql://user:password@host:port/database

# ============================================
# OPENROUTER API
# ============================================
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ============================================
# LLM MODELS (OpenRouter)
# ============================================
LLM_MODEL_CLASSIFY=meta-llama/llama-3.3-70b-instruct:free
LLM_MODEL_SYNTHESIS=google/gemma-3-27b-it:free
LLM_MODEL_FAST=meta-llama/llama-3.1-8b-instruct:free

# ============================================
# NEO4J GRAPH DATABASE
# ============================================
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ============================================
# REDIS CACHE
# ============================================
REDIS_URL=redis://localhost:6379

# ============================================
# EMBEDDINGS
# ============================================
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ============================================
# APPLICATION SETTINGS
# ============================================
APP_NAME=NEXUS
DEBUG=false
LOG_LEVEL=INFO

# ============================================
# CHUNKING CONFIGURATION
# ============================================
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# ============================================
# RETRIEVAL CONFIGURATION
# ============================================
TOP_K_DENSE=5
TOP_K_KEYWORD=5
TOP_K_HYBRID=10
TOP_K_GRAPH=5

# ============================================
# GUARDRAILS CONFIGURATION
# ============================================
ENABLE_INPUT_GUARD=true
ENABLE_OUTPUT_GUARD=true
MAX_TOKENS_OUTPUT=2048

# ============================================
# EVALUATION CONFIGURATION
# ============================================
# EVAL_DATASET_PATH=/path/to/eval/dataset.json
# MLFLOW_TRACKING_URI=http://localhost:5000
